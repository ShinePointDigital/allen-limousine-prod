PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allan_livery?connection_limit=10&pool_timeout=10
SESSION_SECRET=replace-with-a-long-random-string
TWILIO_FROM_NUMBER=+13125550188
# Optional: Twilio will post delivery updates here after accepted sends.
# Example: https://your-production-domain.example/api/webhooks/twilio/status
TWILIO_STATUS_CALLBACK_URL=
# Required with TWILIO_STATUS_CALLBACK_URL to verify Twilio's webhook signature.
# Store this provider credential only in Replit Secrets.
TWILIO_AUTH_TOKEN=
# Optional when the connected Twilio account exposes multiple accounts:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAIL=admin@allanlivery.com
ADMIN_BOOTSTRAP_PASSWORD=change-this-before-production
ALLOW_IN_MEMORY_DEMO=false
# Optional browser key for Google Places Autocomplete. Restrict it to your site domains
# and the Maps JavaScript API / Places API in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
# Private server key for Geocoding, Directions, and Distance Matrix APIs.
# Store this credential only in Replit Secrets; never expose it to browser code.
GOOGLE_MAPS_SERVER_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_DISPATCH_PHONE=
# Add these through Replit Secrets when Stripe is ready. Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=