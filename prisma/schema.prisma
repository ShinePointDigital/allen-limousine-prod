generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id               String            @id @default(cuid())
  email            String            @unique
  name             String
  passwordHash     String
  role             String            @default("SUPER_ADMIN")
  permissions      String[]          @default([])
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         AdminSession[]
  passwordReset    AdminPasswordReset?
  notes            InquiryNote[]
  dispatchMessages DispatchMessage[]
  smsMessages      SmsMessage[]
  reconciledMessages DispatchMessage[] @relation("DispatchReconciler")
  customerBookings Inquiry[]         @relation("CustomerBookings")
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminPasswordReset {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Inquiry {
  id            String              @id @default(cuid())
  dispatchStep       Int                 @default(1)
  dispatchStatus     String              @default("NEW")
  dispatchVersion    Int                 @default(0)
  dispatchReviewedAt DateTime?
  customerUserId String?
  customerUser  AdminUser?           @relation("CustomerBookings", fields: [customerUserId], references: [id], onDelete: SetNull)
  fullName      String
  email         String
  phone         String
  serviceType   String
  pickupAt      DateTime
  pickup        String
  destination   String
  passengers    Int
  notes         String?
  airportCode       String?
  airportTerminal   String?
  flightNumber      String?
  flightScheduledAt DateTime?
  pickupPreference  String?
  isPrivateFBO      Boolean             @default(false)
  specificTailNumber String?
  principalName       String?
  fboName             String?
  tarmacInstructions  String?
  rateTier           String?
  estimatedFareCents Int?
  estimatedMiles     Float?
  estimatedMinutes   Float?
  rideTiming         String?
  promoCode          String?
  promoDiscountCents Int?
  grossFareCents     Int?
  bookingRequestId   String?             @unique
  bookingRequestFingerprint String?
  trackingTokenHash        String?             @unique
  trackingExpiresAt        DateTime?
  stripeCustomerId        String?
  stripePaymentMethodId   String?
  stripePaymentIntentId   String?
  paymentStatus           String?
  status        String              @default("NEW")
  source        String              @default("website")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  inquiryNotes  InquiryNote[]
  ride          Ride?
  notifications AdminNotification[]

  @@index([status, createdAt])
  @@index([email])
  @@index([pickupAt])
  @@index([customerUserId])
}

model StripeSetupSession {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  setupIntentId String    @unique
  customerId    String
  email         String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

model StripeCustomerProfile {
  id               String   @id @default(cuid())
  email            String   @unique
  fullName         String
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model InquiryNote {
  id        String    @id @default(cuid())
  body      String
  inquiryId String
  authorId  String?
  authorName String?
  createdAt DateTime  @default(now())
  inquiry   Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author    AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  eyebrow     String
  description String
  imageUrl    String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model Ride {
  id               String            @id @default(cuid())
  driverId         String?
  driver           Chauffeur?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  inquiryId        String            @unique
  vehicleId        String?
  status           String            @default("UNASSIGNED")
  driverName       String?
  driverPhone      String?
  driverLatitude   Float?
  driverLongitude  Float?
  driverHeading    Float?
  locationUpdatedAt DateTime?
  quoteCents       Int               @default(0)
  depositCents     Int               @default(0)
  collectedCents   Int               @default(0)
  expenseCents     Int               @default(0)
  dispatchNotes    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  inquiry          Inquiry           @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  vehicle          FleetVehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  dispatchMessages DispatchMessage[]

  @@index([status, updatedAt])
  @@index([vehicleId, status])
  @@index([driverId, status])
}

model Chauffeur {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rides     Ride[]
}

model DispatchMessage {
  id                String    @id @default(cuid())
  dispatchRecipient String?
  rideId            String
  adminId           String?
  adminName         String?
  toPhone           String
  body              String
  status            String    @default("SENT")
  providerMessageId String?   @unique
  providerStatus    String?
  deliveryStatus    String?
  errorMessage      String?
  reconciledAt      DateTime?
  reconciledById    String?
  reconciledByName  String?
  createdAt         DateTime  @default(now())
  ride              Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  admin             AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  reconciledBy      AdminUser? @relation("DispatchReconciler", fields: [reconciledById], references: [id], onDelete: SetNull)

  @@index([rideId, createdAt])
  @@index([status, createdAt])
  @@index([rideId, dispatchRecipient, status])
}

model SmsConversation {
  id           String       @id @default(cuid())
  phone        String       @unique
  unreadCount  Int          @default(0)
  optedOutAt   DateTime?
  lastMessageAt DateTime    @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  messages     SmsMessage[]

  @@index([lastMessageAt])
}

model SmsMessage {
  id                String          @id @default(cuid())
  conversationId    String
  direction         String
  providerMessageId String?         @unique
  fromPhone         String
  toPhone           String
  body              String
  status            String          @default("RECEIVED")
  providerStatus    String?
  deliveryStatus    String?
  errorMessage      String?
  adminId           String?
  adminName         String?
  createdAt         DateTime        @default(now())
  conversation      SmsConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  admin             AdminUser?      @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model AdminNotification {
  id        String    @id @default(cuid())
  type      String    @default("NEW_INQUIRY")
  title     String
  body      String
  inquiryId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  inquiry   Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([readAt, createdAt])
}

model FleetVehicle {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String
  imageUrl    String
  passengers  String
  luggage     String
  defaultDriverName  String?
  defaultDriverPhone String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rides       Ride[]

  @@index([active, sortOrder])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
